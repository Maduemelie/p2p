# Bybit P2P Tracker Proxy Configuration

# The port where your local proxy server will run
PORT=3000

# Set to true for Bybit Testnet, false for Bybit Mainnet
BYBIT_TESTNET=false

# Your Bybit API Key (Ensure it has "FiatP2P" permissions enabled)
BYBIT_API_KEY=your_bybit_api_key_here

# Your Bybit API Secret
BYBIT_API_SECRET=your_bybit_api_secret_here

# AI Development Content Generator Configuration (Milestone 1)
# Google Gemini API Key for CrewAI pipeline
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Identifier (Default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

